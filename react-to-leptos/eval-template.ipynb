{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "title",
   "metadata": {},
   "source": [
    "# React to Leptos Converter with Evaluation\n",
    "\n",
    "Select a model and **prompt file**, paste React code, click **Convert to Leptos**. The generated code appears on the right and is saved as a `.rs` file in `./exports` with the model name in the filename.\n",
    "\n",
    "**Evaluate Conversion**: After converting, click **Evaluate Conversion** to automatically grade the React→Leptos conversion quality.\n",
    "\n",
    "Below, there's also a separate **Evaluation** section where you can manually paste any code for custom evaluation from `evaluation.py`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "setup",
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import re\n",
    "import tempfile\n",
    "import time\n",
    "import importlib\n",
    "from pathlib import Path\n",
    "\n",
    "import gradio as gr\n",
    "import tomllib\n",
    "from openai import OpenAI\n",
    "\n",
    "# Use absolute path to the notebook directory\n",
    "NOTEBOOK_DIR = Path('/home/daniel/Documents/ai-project/AI-AGENTS/react-to-leptos')\n",
    "MODELS_TOML = NOTEBOOK_DIR / \"models.toml\"\n",
    "PROMPTS_DIR = NOTEBOOK_DIR / \"prompts\"\n",
    "EXPORT_DIR = NOTEBOOK_DIR / \"exports\"\n",
    "EVAL_PY = NOTEBOOK_DIR / \"evaluation.py\"\n",
    "os.makedirs(EXPORT_DIR, exist_ok=True)\n",
    "\n",
    "FENCE_RE = re.compile(r'```(?:\\w+)?\\s*\\n(.*?)```', re.DOTALL)\n",
    "NEEDS_HUMAN_PREFIX = 'NEEDS-HUMAN'\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load_config",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_config(path=MODELS_TOML):\n",
    "    if not path.exists():\n",
    "        print(f'Warning: {path} not found. Using defaults.')\n",
    "        return {\"ollama\": {\"url\": \"http://localhost:11434/v1\"}, \"models\": {}}\n",
    "    with open(path, \"rb\") as f:\n",
    "        return tomllib.load(f)\n",
    "\n",
    "CONFIG = load_config()\n",
    "OLLAMA_URL = CONFIG.get(\"ollama\", {}).get(\"url\", \"http://localhost:11434\")\n",
    "# Ensure Ollama URL has /v1 for OpenAI API compatibility\n",
    "if not OLLAMA_URL.endswith('/v1'):\n",
    "    OLLAMA_URL = OLLAMA_URL.rstrip('/') + '/v1'\n",
    "MODELS = CONFIG.get(\"models\", {})\n",
    "\n",
    "print(f\"Models config: {MODELS_TOML}\")\n",
    "print(f\"Ollama server: {OLLAMA_URL}\")\n",
    "if MODELS:\n",
    "    for name, cfg in MODELS.items():\n",
    "        print(f\"  {name} -> {cfg.get('model_id')} (temp={cfg.get('temperature', 0.7)})\")\n",
    "else:\n",
    "    print(\"  No models configured in models.toml\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load_prompts",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load all .md files from prompts/ as prompt choices\n",
    "# Each file becomes a choice in the dropdown\n",
    "def load_prompts(directory=PROMPTS_DIR):\n",
    "    prompts = {}\n",
",
    "    if not directory.exists():\n",
    "        directory.mkdir(parents=True, exist_ok=True)\n",
    "        print(f'Created prompts directory: {directory}')\n",
    "    \n",
    "    for file in sorted(directory.glob(\"*.md\")):\n",
    "        filename = file.name\n",
    "        prompts[filename] = file.read_text(encoding=\"utf-8\").strip()\n",
    "    return prompts\n",
    "\n",
    "PROMPTS = load_prompts()\n",
    "print(f\"Prompts directory: {PROMPTS_DIR}\")\n",
    "print(f\"Found prompt files: {list(PROMPTS.keys())}\")\n",
    "if PROMPTS:\n",
    "    for filename in PROMPTS:\n",
    "        print(f\"  {filename}\")\n",
    "else:\n",
    "    print(\"No prompts found. Create .md files in prompts/ directory\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load_evaluation",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load evaluation module\n",
    "if EVAL_PY.exists():\n",
    "    import evaluation as evaluation_module\n",
    "    print(f'Loaded evaluation module: {EVAL_PY}')\n",
    "else:\n",
    "    print(f'Warning: {EVAL_PY} not found. Evaluation will not work.')\n",
    "    print('Create evaluation.py with: def evaluation(input_text: str) -> str')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "converter",
   "metadata": {},
   "outputs": [],
   "source": [
    "def strip_fences(text):\n",
    "    text = (text or '').strip()\n",
    "    match = FENCE_RE.search(text)\n",
    "    if match:\n",
    "        return match.group(1).strip()\n",
    "    if text.startswith('```'):\n",
    "        text = '\\n'.join(text.splitlines()[1:])\n",
    "    return text.strip()\n",
    "\n",
    "\n",
    "def export_leptos(leptos_code, model_name):\n",
    "    if not leptos_code or not leptos_code.strip():\n",
    "        return None\n",
    "    # Create filename with model name: component-{model}-{timestamp}.rs\n",
    "    timestamp = time.strftime('%Y%m%d-%H%M%S')\n",
    "    safe_model = model_name.replace('/', '-').replace(':', '-')\n",
    "    filename = EXPORT_DIR / f'component-{safe_model}-{timestamp}.rs'\n",
    "    with open(filename, 'w', encoding='utf-8') as f:\n",
    "        f.write(leptos_code.rstrip() + '\\n')\n",
    "    os.chmod(filename, 0o644)\n",
    "    return str(filename)\n",
    "\n",
    "\n",
    "def get_model_cfg(model_name):\n",
    "    cfg = MODELS.get(model_name, {})\n",
    "    return {\n",
    "        'model_id': cfg.get('model_id', model_name),\n",
    "        'temperature': cfg.get('temperature', 0.0),\n",
    "        'base_url': OLLAMA_URL,\n",
    "        'api_key': 'ollama'\n",
    "    }\n",
    "\n",
    "\n",
    "def convert(react_code, model_name, prompt_filename):\n",
    "    if not react_code or not react_code.strip():\n",
    "        return '', None\n",
    "    \n",
    "    if not prompt_filename or not prompt_filename.strip():\n",
    "        return 'Error: No prompt selected or prompt is empty', None\n",
    "    \n",
    "    # Get prompt text from selected filename\n",
    "    prompt_text = PROMPTS.get(prompt_filename, '')\n",
    "    if not prompt_text:\n",
    "        return 'Error: Could not load prompt text', None\n",
    "    \n",
    "    model_cfg = get_model_cfg(model_name)\n",
    "    print(f\"Connecting to: {model_cfg['base_url']} with model {model_cfg['model_id']}\")\n",
    "    client = OpenAI(base_url=model_cfg['base_url'], api_key=model_cfg['api_key'])\n",
    "    \n",
    "    for attempt in range(3):\n",
    "        try:\n",
    "            response = client.chat.completions.create(\n",
    "                model=model_cfg['model_id'],\n",
    "                temperature=model_cfg['temperature'],\n",
    "                max_tokens=4096,\n",
    "                messages=[\n",
    "                    {'role': 'system', 'content': prompt_text},\n",
    "                    {'role': 'user', 'content': f'Convert:\\n```tsx\\n{react_code}\\n```'},\n",
    "                ],\n",
    "            )\n",
    "            raw = (response.choices[0].message.content or '').strip()\n",
    "            \n",
    "            if raw.startswith(NEEDS_HUMAN_PREFIX):\n",
    "                return raw, None\n",
    "            \n",
    "            code = strip_fences(raw)\n",
    "            return code, export_leptos(code, model_name)\n",
    "        except Exception as e:\n",
    "            print(f'Retry {attempt + 1} with {model_cfg[\"model_id\"]}: {type(e).__name__}: {e}')\n",
    "            time.sleep(2)\n",
    "    return f'Error: Could not connect to LLM for model {model_cfg[\"model_id\"]}', None\n",
    "\n",
    "\n",
    "def on_prompt_change(prompt_filename):\n",
    "    '''Show which prompt is selected'''\n",
    "    if prompt_filename and prompt_filename in PROMPTS:\n",
    "        return f\"Prompt: {prompt_filename}\"\n",
    "    return \"No prompt selected\"\n",
    "\n",
    "\n",
    "# Evaluation functions\n",
    "def run_evaluation(pasted_text):\n",
    "    '''Run evaluation on pasted text'''\n",
    "    if 'evaluation_module' not in globals():\n",
    "        return 'Error: evaluation.py not loaded'\n",
    "    try:\n",
    "        return evaluation_module.evaluation(pasted_text)\n",
    "    except Exception as e:\n",
    "        return f'Error in evaluation: {type(e).__name__}: {e}'\n",
    "\n",
    "\n",
    "def reload_evaluation_module():\n",
    "    '''Reload evaluation.py without restarting kernel'''\n",
    "    global evaluation_module\n",
    "    if EVAL_PY.exists():\n",
    "        importlib.reload(evaluation_module)\n",
    "        return '* evaluation.py reloaded *'\n",
    "    return 'Error: evaluation.py not found'\n",
    "\n",
    "\n",
    "def evaluate_conversion(react_code, leptos_code, model_name):\n",
    "    '''Evaluate the React-to-Leptos conversion using both inputs'''\n",
    "    if 'evaluation_module' not in globals():\n",
    "        return 'Error: evaluation.py not loaded'\n",
    "    \n",
    "    # Format input with markers for evaluation.py\n",
    "    input_text = f'<react_source>\\n{react_code}\\n</react_source>\\n\\n<leptos_output>\\n{leptos_code}\\n</leptos_output>'\n",
    "    \n",
    "    try:\n",
    "        result = evaluation_module.evaluation(input_text)\n",
    "        return result\n",
    "    except Exception as e:\n",
    "        return f'Error evaluating conversion: {type(e).__name__}: {e}'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ui",
   "metadata": {},
   "outputs": [],
   "source": [
    "with gr.Blocks(title='React to Leptos Converter + Evaluation') as app:\n",
    "    gr.Markdown('# React to Leptos Converter')\n",
    "    gr.Markdown('Select a model and **prompt file**, paste React code, click **Convert to Leptos**.')\n",
    "    \n",
    "    # === CONVERTER SECTION ===\n",
    "    with gr.Row():\n",
    "        model_dd = gr.Dropdown(\n",
    "            choices=list(MODELS.keys()) if MODELS else [],\n",
    "            value=next(iter(MODELS.keys()), None) if MODELS else None,\n",
    "            label='Model',\n",
    "            interactive=bool(MODELS)\n",
    "        )\n",
    "        prompt_dd = gr.Dropdown(\n",
    "            choices=list(PROMPTS.keys()) if PROMPTS else [],\n",
    "            value=next(iter(PROMPTS.keys()), None) if PROMPTS else None,\n",
    "            label='Prompt File',\n",
    "            interactive=bool(PROMPTS)\n",
    "        )\n",
    "    \n",
    "    prompt_status = gr.Markdown()\n",
    "    prompt_text_state = gr.State(value='')\n",
    "    \n",
    "    with gr.Row():\n",
    "        react_input = gr.Textbox(\n",
    "            label='React Component',\n",
    "            placeholder='Paste React code here...',\n",
    "            lines=20,\n",
    "            max_lines=40,\n",
    "        )\n",
    "        with gr.Column():\n",
    "            leptos_output = gr.Textbox(\n",
    "                label='Leptos Component',\n",
    "                placeholder='Leptos code appears here...',\n",
    "                lines=20,\n",
    "                max_lines=40,\n",
    "                interactive=False,\n",
    "                buttons=['copy'],\n",
    "            )\n",
    "            export_file = gr.File(\n",
    "                label='Download .rs',\n",
    "                file_count='single',\n",
    "                interactive=False,\n",
    "            )\n",
    "    \n",
    "    # Evaluation result for conversion\n",
    "    eval_result = gr.Textbox(\n",
    "        label='Conversion Evaluation',\n",
    "        lines=15,\n",
    "        interactive=False,\n",
    "        visible=False\n",
    "    )\n",
    "    \n",
    "    with gr.Row():\n",
    "        convert_btn = gr.Button('Convert to Leptos', variant='primary')\n",
    "        clear_btn = gr.ClearButton([react_input, leptos_output, export_file, eval_result])\n",
    "        eval_convert_btn = gr.Button('Evaluate Conversion', variant='secondary')\n",
    "    \n",
    "    # Event handlers for converter\n",
    "    prompt_dd.change(\n",
    "        fn=on_prompt_change,\n",
    "        inputs=prompt_dd,\n",
    "        outputs=prompt_status\n",
    "    )\n",
    "    \n",
    "    convert_btn.click(\n",
    "        fn=convert,\n",
    "        inputs=[react_input, model_dd, prompt_dd],\n",
    "        outputs=[leptos_output, export_file],\n",
    "    )\n",
    "    \n",
    "    react_input.submit(\n",
    "        fn=convert,\n",
    "        inputs=[react_input, model_dd, prompt_dd],\n",
    "        outputs=[leptos_output, export_file],\n",
    "    )\n",
    "    \n",
    "    # Evaluate the conversion using both inputs\n",
    "    eval_convert_btn.click(\n",
    "        fn=evaluate_conversion,\n",
    "        inputs=[react_input, leptos_output, model_dd],\n",
    "        outputs=[eval_result]\n",
    "    )\n",
    "    \n",
    "    # Show evaluation result when it has content\n",
    "    eval_result.change(\n",
    "        fn=lambda x: gr.update(visible=bool(x and x.strip())),\n",
    "        inputs=eval_result,\n",
    "        outputs=eval_result\n",
    "    )\n",
    "    \n",
    "    # === EVALUATION SECTION (below converter) ===\n",
    "    gr.Markdown('---')\n",
    "    gr.Markdown('## Manual Evaluation')\n",
    "    gr.Markdown('Paste code or text below and click **Evaluate** to run custom checks from `evaluation.py`. Useful for evaluating code not from the converter above.')\n",
    "    \n",
    "    eval_status = gr.Markdown()\n",
    "    with gr.Row():\n",
    "        eval_input = gr.Textbox(\n",
    "            label='Paste here',\n",
    "            lines=10,\n",
    "            placeholder='Paste anything you want evaluated...'\n",
    "        )\n",
    "        manual_eval_output = gr.Textbox(\n",
    "            label='Result',\n",
    "            lines=10,\n",
    "            interactive=False\n",
    "        )\n",
    "    \n",
    "    with gr.Row():\n",
    "        manual_eval_btn = gr.Button('Evaluate', variant='primary')\n",
    "        reload_btn = gr.Button('Reload evaluation.py', size='sm')\n",
    "    \n",
    "    # Event handlers for manual evaluation\n",
    "    manual_eval_btn.click(\n",
    "        fn=run_evaluation,\n",
    "        inputs=eval_input,\n",
    "        outputs=manual_eval_output\n",
    "    )\n",
    "    reload_btn.click(\n",
    "        fn=reload_evaluation_module,\n",
    "        outputs=eval_status\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "launch",
   "metadata": {},
   "outputs": [],
   "source": [
    "app.launch()\n"
   ]
  }
 ],
